# ===============================================
# Modern Food Service - Environment Variables
# ===============================================

# 1. Database Configuration
# Local SQLite (Out of the box without Docker):
DATABASE_URL=sqlite+aiosqlite:///./foodservice.db

# Docker / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/foodservice

# 2. Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# 3. Security & JWT
SECRET_KEY=change-this-super-secret-key-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TABLE_TOKEN_EXPIRE_HOURS=6

# 4. Telegram Staff & Kitchen Bot
# Create bot via @BotFather in Telegram and obtain API token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram Group or Channel Chat ID (e.g. -1001234567890 or your personal user ID)
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# 5. URLs & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# 6. Restaurant Info
RESTAURANT_NAME=Bistro Moderne
TAX_RATE=0.08
ESTIMATED_PREP_MINUTES=20

# 7. Admin Dashboard Authentication
# Only this Gmail address will be permitted to log in to the admin panel
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Restaurant Admin

# 8. Real Google (Gmail) Email OTP
# Server settings for smtp.gmail.com:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Google App Password (16 letters generated from https://myaccount.google.com/apppasswords):
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Food_Service
SMTP_TLS=true
OTP_EXPIRE_MINUTES=10

# 9. ABA PayWay Payment Gateway
PAYMENT_GATEWAY_PROVIDER=payway
# Set your ABA Bank Account (USD and KHR)
ABA_PAY_ACCOUNT_ID=
ABA_PAY_KEY_ID=
ABA_PAY_CODE=
ABA_PAY_USD_ACC=
ABA_PAY_KHR_ACC=
# Payment auto-confirmation (0 = disabled, real bank verification only)
AUTO_CONFIRM_PAYMENT_SECONDS=0

# Optional ABA PayWay / KHQR.cc Gateway
KHQRCC_BASE_URL=https://khqr.cc
KHQRCC_PROFILE_ID=
KHQRCC_API_SECRET=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
# Currency Conversion (1 USD = 4,100 KHR)
EXCHANGE_RATE_USD_KHR=4100


